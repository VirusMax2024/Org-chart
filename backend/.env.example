# ─── Aiven PostgreSQL Connection ─────────────────────────────
# คัดลอก URL จาก Aiven Console → Service Overview → Connection Information
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:PORT/defaultdb?sslmode=require

# ─── Server Port ──────────────────────────────────────────────
PORT=3001
