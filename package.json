{
  "name": "org-chart-app",
  "version": "1.0.0",
  "description": "Full-Stack Org Chart App — React + Express + Aiven PostgreSQL",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix frontend",
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "db:init": "npm run db:init --prefix backend",
    "admin": "npm run admin --prefix backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
